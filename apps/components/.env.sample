# stream components — sample environment
# Copy to .env and customise, or run directly with --env-file apps/components/.env.sample

# Identity — the stream's public key is derived from these three values.
STREAM_NAME=components
STREAM_USERNAME=demo
STREAM_PASSWORD=demo1234

# Where to persist stream data between runs.
STREAM_DATA_DIR=.stream

# HTTP + WebSocket port for the components demo.
STREAM_WEB=8080

# Drop into a REPL after startup (get/set/ls/stream/registry available).
STREAM_INTERACTIVE=true
