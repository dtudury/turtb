# stream browser — sample environment
# Copy to .env and customise, or run directly with --env-file apps/browser/.env.sample

# Identity — the stream's public key is derived from these three values.
# Changing any of them gives you a completely different stream.
STREAM_NAME=browser-app
STREAM_USERNAME=demo
STREAM_PASSWORD=demo1234

# Mirror a local folder into the stream (and back out on change).
# Edit files in the browser and they update on disk; edit on disk and the
# browser reflects the change. Set to a path or leave as '.' for cwd.
STREAM_FILES=.

# Where to persist stream data between runs.
STREAM_DATA_DIR=.stream

# HTTP + WebSocket port for the browser app.
STREAM_WEB=8080

# Drop into a REPL after startup (get/set/ls/stream/registry available).
STREAM_INTERACTIVE=true
